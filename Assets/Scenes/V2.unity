      m_Calls: []
  m_text: "<size=120%><color=#61E2FF><b>Understanding the Odds (Cont.)</b></color></size>\r\n\r\n<color=#61E2FF><b>Negative
    Odds (-):</b></color>\r\nThese odds are lower risk wagers, as the chances of
    this team winning are higher compared to the other team. The lower the number,
    the more likely it is for the team to win. Since this wager is lower risk, if
    the team selected wins, the payout is much less compared to the team with greater
    positive odds- but it is safer. \r\n\r\n<size=110%><color=#4A90E2>\u2022 <b>Negative
    odds lower risk, smaller reward</b></color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
