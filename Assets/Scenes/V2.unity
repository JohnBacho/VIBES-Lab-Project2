  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=120%><color=#FFFF00><b>What is a parlay?</b></color></size>\n\nA
    <color=#00FFFF><b>parlay</b></color> is a single bet that links together multiple
    individual wagers (referred to as <b>legs</b>). For each leg you will choose
    between two competing teams. \n\n\u2022 <b><color=#00FF00>Selection:</color></b>
    For this study you must select between <b>3 and 5</b> legs to build your parlay\n\u2022
    <b><color=#FFCC00>Winning Criteria:</color></b> For the parlay to win, all of
    the individual legs need to win."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
