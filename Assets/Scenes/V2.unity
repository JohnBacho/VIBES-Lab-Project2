      m_Calls: []
  m_text: "<size=120%><color=#FFD700><b>Understanding the Odds</b></color></size>\r\n\r\nThe
    betting odds displayed (ex. -150, +200) define the likelihood a team will win
    as well as the amount of money you can win from a bet.\r\n\r\n<color=#FFB347><b>Positive
    Odds (+):</b></color> \r\nThese odds are higher risk wagers, as the chances of
    this team winning are lower compared to another team. The higher the number,
    the less likely it is for the team to win. As this wage is higher risk, if the
    team you select wins the payout is much higher compared to that of lower negative
    odds- but it is riskier.\r\n\r\n<size=110%><color=#FFD700>\u2022 <b>Positive
    Odds are higher risk, larger reward</b></color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
